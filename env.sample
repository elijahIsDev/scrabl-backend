# ============================================================
# SCRABL — Environment variables
# Copy to ".env" for local dev. On PXXL, add each of these in
# the dashboard under your app's Environment / Variables.
# Do NOT set PORT on PXXL — the platform provides it.
# ============================================================

# --- Core ---
NODE_ENV=production

# --- Google Gemini (content generation) ---
GOOGLE_API_KEY=your_new_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- MongoDB Atlas (accounts, onboarding, feedback) ---
MONGO_URI=your_new_mongodb_connection_string_here

# --- Auth (signing login tokens) — use a long random string ---
AUTH_SECRET=generate_a_long_random_string_here

# --- Email sending (Resend HTTP API) ---
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=Scrabl <onboarding@resend.dev>

# --- Admin notifications (optional) ---
WAITLIST_NOTIFICATION_EMAIL=scrablmedia@gmail.com

# --- Feedback admin view (optional) ---
FEEDBACK_ADMIN_KEY=pick_any_secret_word

# --- Gmail SMTP fallback (optional; only if not using Resend) ---
# SMTP_EMAIL=scrablmedia@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
